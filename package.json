{
  "name": "crash",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc --noEmit -p worker && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "icons": "node scripts/make-icons.mjs",
    "cf:dev": "pnpm build && pnpm db:migrate:local && wrangler dev",
    "cf:deploy": "pnpm build && wrangler deploy",
    "cf:check": "pnpm build && wrangler deploy --dry-run",
    "ai:tables": "node --experimental-transform-types --no-warnings scripts/build-ai-tables.ts",
    "db:migrate:local": "wrangler d1 migrations apply crash-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply crash-db --remote"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "canvas-confetti": "^1.9.4",
    "motion": "^13.4.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "playwright": "1.56.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.2",
    "workbox-window": "^7.4.1",
    "wrangler": "^4.143.0"
  }
}
